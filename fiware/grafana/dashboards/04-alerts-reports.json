    {
      "id": 11,
      "type": "state-timeline",
      "title": "Alert timeline by rule",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "aura-timescale"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "aura-timescale"
          },
          "refId": "A",
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH s AS (\n  SELECT entityid, ts, text AS status FROM attributes\n  WHERE entityid LIKE 'urn:ngsi-ld:Alert:%' AND id LIKE '%/status' AND $__timeFilter(ts)\n), r AS (\n  SELECT DISTINCT ON (entityid) entityid, text AS rule FROM attributes\n  WHERE entityid LIKE 'urn:ngsi-ld:Alert:%' AND id LIKE '%/subCategory' ORDER BY entityid, ts DESC\n)\nSELECT s.ts AS \"time\", r.rule AS metric, s.status AS value\nFROM s JOIN r USING (entityid) ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
