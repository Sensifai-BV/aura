    {
      "id": 13,
      "type": "table",
      "title": "Mission reports",
      "description": "Automated per-mission evidence package. Click a mission to open its printable report (aura-monitor).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "aura-timescale"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 24,
        "h": 12
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "aura-timescale"
          },
          "refId": "A",
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH r AS (\n  SELECT DISTINCT ON (entityid, id) entityid, split_part(id, '/', -1) AS attr, number, text, boolean,\n         coalesce(observedat, ts) AS t\n  FROM attributes\n  WHERE entityid LIKE 'urn:ngsi-ld:MissionReport:%'\n  ORDER BY entityid, id, ts DESC\n)\nSELECT split_part(entityid, ':', 4) AS \"Mission\", max(t) AS \"Ended\",\n  max(text) FILTER (WHERE attr = 'verdict') AS \"Verdict\", max(text) FILTER (WHERE attr = 'operator') AS \"Operator\", max(text) FILTER (WHERE attr = 'condition') AS \"Condition\",\n  max(number) FILTER (WHERE attr = 'durationMin') AS \"Duration\", max(number) FILTER (WHERE attr = 'commandCount') AS \"Commands\",\n  max(number) FILTER (WHERE attr = 'commandSuccessRate') AS \"Success\", max(number) FILTER (WHERE attr = 'falseActivationRate') AS \"False act.\",\n  max(number) FILTER (WHERE attr = 'rejectionRate') AS \"Rejection\", max(number) FILTER (WHERE attr = 'confirmationLoopRate') AS \"Loops / 10\",\n  max(number) FILTER (WHERE attr = 'meanLatency') AS \"Latency\", max(number) FILTER (WHERE attr = 'timeToSafeStop') AS \"Safe-stop\",\n  max(number) FILTER (WHERE attr = 'alertsCount') AS \"Alerts\", max(number) FILTER (WHERE attr = 'distance') AS \"Distance\", max(number) FILTER (WHERE attr = 'batteryUsed') AS \"Battery used\"\nFROM r WHERE entityid IN (SELECT entityid FROM r GROUP BY entityid HAVING max(t) >= $__timeFrom())\nGROUP BY entityid ORDER BY 2 DESC"
        }
      ],
