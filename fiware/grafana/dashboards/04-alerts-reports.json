    {
      "id": 3,
      "type": "stat",
      "title": "Open",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "aura-timescale"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "aura-timescale"
          },
          "refId": "A",
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH a AS (\n  SELECT DISTINCT ON (entityid, id) entityid, split_part(id, '/', -1) AS attr, number, text, ts\n  FROM attributes\n  WHERE entityid LIKE 'urn:ngsi-ld:Alert:%'\n  ORDER BY entityid, id, ts DESC\n), f AS (\n  SELECT entityid, min(ts) AS issued, max(ts) AS updated FROM attributes\n  WHERE entityid LIKE 'urn:ngsi-ld:Alert:%' GROUP BY entityid\n), alerts AS (\n  SELECT a.entityid, f.issued, f.updated,\n    max(text) FILTER (WHERE attr = 'severity') AS severity,\n    max(text) FILTER (WHERE attr = 'status') AS status,\n    max(text) FILTER (WHERE attr = 'category') AS category,\n    max(text) FILTER (WHERE attr = 'subCategory') AS rule,\n    max(text) FILTER (WHERE attr = 'description') AS description,\n    max(text) FILTER (WHERE attr = 'missionId') AS mission,\n    max(number) FILTER (WHERE attr = 'value') AS value,\n    max(number) FILTER (WHERE attr = 'threshold') AS threshold\n  FROM a JOIN f USING (entityid) GROUP BY a.entityid, f.issued, f.updated\n)\nSELECT count(*) FILTER (WHERE status <> 'resolved') AS \"Open\",\n  count(*) FILTER (WHERE status <> 'resolved' AND severity = 'critical') AS \"Critical\",\n  count(*) FILTER (WHERE status <> 'resolved' AND severity = 'high') AS \"High\",\n  count(*) FILTER (WHERE status <> 'resolved' AND severity = 'medium') AS \"Medium\",\n  count(*) FILTER (WHERE status <> 'resolved' AND severity IN ('low','informational')) AS \"Low / info\",\n  count(*) FILTER (WHERE $__timeFilter(issued)) AS \"Raised in range\"\nFROM alerts"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#22c55e",
                "value": null
              },
              {
                "color": "#60a5fa",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^Open$/",
          "values": false
        },
        "colorMode": "background_solid",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      }
    },
