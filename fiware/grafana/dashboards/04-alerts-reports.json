    {
      "id": 9,
      "type": "table",
      "title": "Alerts",
      "description": "Raised and resolved by aura-monitor (hysteresis rules on HRI, robot, environment and middleware signals).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "aura-timescale"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 16,
        "h": 12
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "aura-timescale"
          },
          "refId": "A",
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH a AS (\n  SELECT DISTINCT ON (entityid, id) entityid, split_part(id, '/', -1) AS attr, number, text, ts\n  FROM attributes\n  WHERE entityid LIKE 'urn:ngsi-ld:Alert:%'\n  ORDER BY entityid, id, ts DESC\n), f AS (\n  SELECT entityid, min(ts) AS issued, max(ts) AS updated FROM attributes\n  WHERE entityid LIKE 'urn:ngsi-ld:Alert:%' GROUP BY entityid\n), alerts AS (\n  SELECT a.entityid, f.issued, f.updated,\n    max(text) FILTER (WHERE attr = 'severity') AS severity,\n    max(text) FILTER (WHERE attr = 'status') AS status,\n    max(text) FILTER (WHERE attr = 'category') AS category,\n    max(text) FILTER (WHERE attr = 'subCategory') AS rule,\n    max(text) FILTER (WHERE attr = 'description') AS description,\n    max(text) FILTER (WHERE attr = 'missionId') AS mission,\n    max(number) FILTER (WHERE attr = 'value') AS value,\n    max(number) FILTER (WHERE attr = 'threshold') AS threshold\n  FROM a JOIN f USING (entityid) GROUP BY a.entityid, f.issued, f.updated\n)\nSELECT issued AS \"Issued\", severity AS \"Severity\", status AS \"Status\", category AS \"Category\",\n  rule AS \"Rule\", description AS \"Description\", value AS \"Value\", threshold AS \"Threshold\",\n  mission AS \"Mission\", updated AS \"Updated\"\nFROM alerts WHERE $__timeFilter(issued) OR status <> 'resolved'\nORDER BY (status = 'resolved'), issued DESC LIMIT 200"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Severity"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "critical": {
                        "text": "CRITICAL",
                        "color": "#ef4444",
                        "index": 0
                      },
                      "high": {
                        "text": "HIGH",
                        "color": "#fb923c",
                        "index": 1
                      },
                      "medium": {
                        "text": "MEDIUM",
                        "color": "#f59e0b",
                        "index": 2
                      },
                      "low": {
                        "text": "LOW",
                        "color": "#60a5fa",
                        "index": 3
                      },
                      "informational": {
                        "text": "INFO",
                        "color": "#64748b",
                        "index": 4
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Status"
